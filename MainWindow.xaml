<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ScreenshotBooth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenshotBooth"
    xmlns:models="using:ScreenshotBooth.Models"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScreenshotBooth"
    mc:Ignorable="d">

    <!-- No Window.SystemBackdrop (Mica/Acrylic) here by design: the booth content is a plain
         white 4:3 area anyway, so a translucent backdrop would not be visible around it, and on
         the dev VM's software (WARP) rendering path MicaBackdrop made the process exit silently
         within ~10s of Window.Activate(). On real GPU/DWM composition it is safe to re-add
         Window.SystemBackdrop with a MicaBackdrop. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="ScreenshotBooth"
            IconSource="ms-appx:///Assets/AppIcon.ico"
            ContextMenuMode="SecondWindow"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem x:Uid="TrayOpen" Click="OnTrayOpenClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExit" Click="OnTrayExitClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar x:Name="AppTitleBar" Title="ScreenshotBooth" Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Toolbar (on top, so drop-downs open over the booth instead of off the bottom edge) -->
        <Grid Grid.Row="1" Padding="16,4,8,4" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Booth size -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox
                    x:Name="PresetComboBox"
                    x:Uid="PresetComboBox"
                    AutomationProperties.AutomationId="PresetComboBox"
                    ItemsSource="{x:Bind ViewModel.Presets}"
                    SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                    Width="160" />
                <NumberBox
                    x:Name="CustomWidthNumberBox"
                    x:Uid="CustomWidthNumberBox"
                    AutomationProperties.AutomationId="CustomWidthNumberBox"
                    Value="{x:Bind ViewModel.CustomWidth, Mode=TwoWay}"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsCustomSizeVisible), Mode=OneWay}"
                    SpinButtonPlacementMode="Hidden"
                    Minimum="100"
                    Maximum="7680"
                    Width="90"
                    PlaceholderText="W" />
                <TextBlock
                    Text="&#xD7;"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsCustomSizeVisible), Mode=OneWay}" />
                <NumberBox
                    x:Name="CustomHeightNumberBox"
                    x:Uid="CustomHeightNumberBox"
                    AutomationProperties.AutomationId="CustomHeightNumberBox"
                    Value="{x:Bind ViewModel.CustomHeight, Mode=TwoWay}"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsCustomSizeVisible), Mode=OneWay}"
                    SpinButtonPlacementMode="Hidden"
                    Minimum="100"
                    Maximum="4320"
                    Width="90"
                    PlaceholderText="H" />
                <ToggleSwitch
                    x:Name="FitToBoothSwitch"
                    x:Uid="FitToBoothSwitch"
                    AutomationProperties.AutomationId="FitToBoothSwitch"
                    IsOn="{x:Bind ViewModel.IsFitToBoothEnabled, Mode=TwoWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FitToBoothToolTip, Mode=OneWay}"
                    MinWidth="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status + actions. The CommandBar sits in a star column so it is measured with the
                 real remaining width and moves trailing commands into its overflow menu when the
                 booth is narrow. -->
            <CommandBar
                Grid.Column="1"
                DefaultLabelPosition="Collapsed"
                OverflowButtonVisibility="Auto"
                IsDynamicOverflowEnabled="True"
                Background="Transparent"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Height="48">
                        <Border
                            x:Name="PinnedIndicator"
                            Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsTargetPinned), Mode=OneWay}"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="14"
                            Padding="10,2,2,2"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Uid="PinnedLabel"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="ReleaseButton"
                                    x:Uid="ReleaseButton"
                                    AutomationProperties.AutomationId="ReleaseButton"
                                    Command="{x:Bind ViewModel.ReleaseCommand}"
                                    Padding="6,2"
                                    MinHeight="0"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE77A;" FontSize="12" />
                                        <TextBlock x:Uid="ReleaseLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </CommandBar.Content>

                <!-- Overflow moves commands from the end: Share, Save, Copy, Countdown, then Retake. -->
                <CommandBar.PrimaryCommands>
                    <AppBarElementContainer VerticalAlignment="Center">
                        <Button
                            x:Name="ShutterButton"
                            x:Uid="ShutterButton"
                            AutomationProperties.AutomationId="ShutterButton"
                            Command="{x:Bind ViewModel.CaptureCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="4,0">
                            <FontIcon Glyph="&#xE722;" FontSize="18" />
                        </Button>
                    </AppBarElementContainer>
                    <AppBarButton
                        x:Name="RetakeButton"
                        x:Uid="RetakeButton"
                        AutomationProperties.AutomationId="RetakeButton"
                        Command="{x:Bind ViewModel.RetakeCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE7A7;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="CountdownButton"
                        x:Uid="CountdownButton"
                        AutomationProperties.AutomationId="CountdownButton"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CountdownToolTip, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE916;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem x:Uid="CountdownOffItem" GroupName="Countdown" Tag="0" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 0), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown3Item" GroupName="Countdown" Tag="3" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 3), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown5Item" GroupName="Countdown" Tag="5" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 5), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown10Item" GroupName="Countdown" Tag="10" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 10), Mode=OneWay}" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="CopyButton"
                        x:Uid="CopyButton"
                        AutomationProperties.AutomationId="CopyButton"
                        Command="{x:Bind ViewModel.CopyCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="SaveButton"
                        x:Uid="SaveButton"
                        AutomationProperties.AutomationId="SaveButton"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ShareButton"
                        x:Uid="ShareButton"
                        AutomationProperties.AutomationId="ShareButton"
                        Command="{x:Bind ViewModel.ShareCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
            </CommandBar>
        </Grid>

        <!-- Booth client area: plain white backdrop whose size is the captured image size. The live
             target window is positioned by BoothController to sit on top of this, centered in it.
             After a capture, PreviewImage replaces the white backdrop with the captured screenshot. -->
        <Border x:Name="BoothArea" Grid.Row="2" Background="White">
            <Grid>
                <Image
                    Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsPreviewShown), Mode=OneWay}"
                    Stretch="UniformToFill" />
                <!-- Overlaid (not a grid row) so opening it never changes the booth area's size. -->
                <InfoBar
                    x:Name="NoticeBar"
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="Informational"
                    VerticalAlignment="Top"
                    Margin="12,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
