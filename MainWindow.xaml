<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ScreenshotBooth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ScreenshotBooth"
    xmlns:models="using:ScreenshotBooth.Models"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ScreenshotBooth"
    mc:Ignorable="d">

    <!-- No Window.SystemBackdrop (Mica/Acrylic) here by design: the booth content is a plain
         white 4:3 area anyway, so a translucent backdrop would not be visible around it, and on
         the dev VM's software (WARP) rendering path MicaBackdrop made the process exit silently
         within ~10s of Window.Activate(). On real GPU/DWM composition it is safe to re-add
         Window.SystemBackdrop with a MicaBackdrop. -->
    <!-- Classic Binding is used where x:Bind cannot convert types (bool -> bool?): a Window is not a
         FrameworkElement, so x:Bind cannot resolve a StaticResource converter here either. -->
    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="ScreenshotBooth"
            IconSource="ms-appx:///Assets/AppIcon.ico"
            ContextMenuMode="SecondWindow"
            NoLeftClickDelay="True">
            <tb:TaskbarIcon.ContextFlyout>
                <!-- ShouldConstrainToRootBounds=False: the tray host window is tiny, and a flyout kept
                     inside it gets clipped. -->
                <MenuFlyout AreOpenCloseAnimationsEnabled="False" ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem x:Uid="TrayPick" Click="OnTrayPickClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#x2316;" FontFamily="Segoe UI Symbol" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="TrayOpen" Click="OnTrayOpenClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExit" Click="OnTrayExitClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar x:Name="AppTitleBar" Title="ScreenshotBooth" Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Toolbar (on top, so drop-downs open over the booth instead of off the bottom edge) -->
        <Grid Grid.Row="1" Padding="16,4,8,4" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Shutter first: it must never be hidden, so it stays out of the overflowable CommandBar. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button
                    x:Name="ShutterButton"
                    x:Uid="ShutterButton"
                    AutomationProperties.AutomationId="ShutterButton"
                    Command="{x:Bind ViewModel.CaptureCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    MinWidth="44">
                    <!-- Driven from code-behind (ShutterCountdown*): x:Bind inside this content did not apply. -->
                    <Grid>
                        <FontIcon x:Name="ShutterCameraIcon" Glyph="&#xE722;" FontSize="18" />
                        <!-- While counting down: the remaining seconds plus a small X (press = cancel). -->
                        <StackPanel x:Name="ShutterCountdownPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                            <FontIcon Glyph="&#xE769;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShutterCountdownText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <!-- Window picker (Spy++-style "finder" scope): click to pick the target on screen. -->
                <Button
                    x:Name="PickerButton"
                    x:Uid="PickerButton"
                    AutomationProperties.AutomationId="PickerButton"
                    Command="{x:Bind ViewModel.PickWindowCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center">
                    <TextBlock Text="&#x2316;" FontFamily="Segoe UI Symbol" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <!-- Size picker as a DropDownButton: the ComboBox left its face blank after its item
                     list was rebuilt on acquire, so label and menu are driven from code-behind. -->
                <DropDownButton
                    x:Name="SizeDropDown"
                    x:Uid="SizeDropDown"
                    AutomationProperties.AutomationId="SizeDropDown"
                    MinWidth="180"
                    VerticalAlignment="Center">
                    <TextBlock x:Name="SizeDropDownText" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!-- Actions. The CommandBar sits in a star column so it is measured with the real remaining
                 width and moves trailing commands into its overflow menu when the booth is narrow. -->
            <CommandBar
                x:Name="Toolbar"
                Grid.Column="1"
                DefaultLabelPosition="Collapsed"
                OverflowButtonVisibility="Visible"
                IsDynamicOverflowEnabled="True"
                Background="Transparent"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center">
                <!-- Overflow moves commands from the end: Share, Save, Copy, Countdown, Retake, then Fit. -->
                <CommandBar.PrimaryCommands>
                    <!-- Fit / retake / countdown carry badges, drawn as vector PathIcons generated from
                         the Segoe glyphs (Tools/Generate-Icons.ps1). Being AppBar buttons, they line up
                         with the others and show icon + label in the overflow menu. The fit and countdown
                         icons are swapped from code-behind. -->
                    <AppBarToggleButton
                        x:Name="FitToBoothToggle"
                        x:Uid="FitToBoothToggle"
                        AutomationProperties.AutomationId="FitToBoothToggle"
                        Width="40"
                        MinWidth="0"
                        IsChecked="{Binding IsFitToBoothEnabled, Mode=TwoWay}"
                        Checked="OnFitToggleStateChanged"
                        Unchecked="OnFitToggleStateChanged"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FitToBoothToolTip, Mode=OneWay}" />
                    <AppBarButton
                        x:Name="RetakeButton"
                        x:Uid="RetakeButton"
                        AutomationProperties.AutomationId="RetakeButton"
                        Width="40"
                        MinWidth="0"
                        Command="{x:Bind ViewModel.RetakeCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}" />
                    <AppBarButton
                        x:Name="CountdownButton"
                        x:Uid="CountdownButton"
                        AutomationProperties.AutomationId="CountdownButton"
                        Width="40"
                        MinWidth="0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CountdownToolTip, Mode=OneWay}">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem x:Uid="CountdownOffItem" GroupName="Countdown" Tag="0" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 0), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown3Item" GroupName="Countdown" Tag="3" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 3), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown5Item" GroupName="Countdown" Tag="5" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 5), Mode=OneWay}" />
                                <RadioMenuFlyoutItem x:Uid="Countdown10Item" GroupName="Countdown" Tag="10" Click="OnCountdownItemClick"
                                    IsChecked="{x:Bind local:MainWindow.IntEquals(ViewModel.CountdownSeconds, 10), Mode=OneWay}" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="CopyButton"
                        Width="40"
                        MinWidth="0"
                        x:Uid="CopyButton"
                        AutomationProperties.AutomationId="CopyButton"
                        Command="{x:Bind ViewModel.CopyCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="SaveButton"
                        Width="40"
                        MinWidth="0"
                        x:Uid="SaveButton"
                        AutomationProperties.AutomationId="SaveButton"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="ShareButton"
                        Width="40"
                        MinWidth="0"
                        x:Uid="ShareButton"
                        AutomationProperties.AutomationId="ShareButton"
                        Command="{x:Bind ViewModel.ShareCommand}"
                        IsEnabled="{x:Bind ViewModel.IsPreviewShown, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.PrimaryCommands>
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton
                        x:Name="RestoreLayoutToggle"
                        x:Uid="RestoreLayoutToggle"
                        AutomationProperties.AutomationId="RestoreLayoutToggle"
                        IsChecked="{Binding IsRestoreLayoutEnabled, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xE72B;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- Booth client area: plain white backdrop whose size is the captured image size. The live
             target window is positioned by BoothController to sit on top of this, centered in it.
             After a capture, PreviewImage replaces the white backdrop with the captured screenshot. -->
        <Border x:Name="BoothArea" Grid.Row="2" Background="White">
            <Grid>
                <Grid.Resources>
                    <!-- "It is a photo now": a flash, then the capture settles into a slightly smaller,
                         tilted print with a white border and a shadow, and a toast lands on top of it.
                         Otherwise the preview is pixel-identical to the live window and the eye cannot tell. -->
                    <Storyboard x:Name="CaptureEffect">
                        <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.45" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PhotoTransform" Storyboard.TargetProperty="ScaleX">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.92" KeySpline="0.2,0.8,0.3,1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PhotoTransform" Storyboard.TargetProperty="ScaleY">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="0.92" KeySpline="0.2,0.8,0.3,1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PhotoTransform" Storyboard.TargetProperty="Rotation">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <SplineDoubleKeyFrame KeyTime="0:0:0.6" Value="-1.5" KeySpline="0.2,0.8,0.3,1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PhotoBorder" Storyboard.TargetProperty="Opacity">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CopiedToast" Storyboard.TargetProperty="Opacity">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.7" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>

                <!-- The print: white border + shadow, scaled/tilted by the storyboard. -->
                <Border
                    x:Name="PhotoBorder"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsPreviewShown), Mode=OneWay}"
                    Background="White"
                    BorderBrush="#33000000"
                    BorderThickness="1"
                    Padding="10"
                    Opacity="0"
                    Translation="0,0,24"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="PhotoTransform" />
                    </Border.RenderTransform>
                    <Image
                        x:Name="PreviewImageElement"
                        Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                        Stretch="Uniform" />
                </Border>

                <Rectangle x:Name="Flash" Fill="White" Opacity="0" IsHitTestVisible="False" />

                <!-- Lands on top of the photo so it cannot be missed. -->
                <Border
                    x:Name="CopiedToast"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#DD202020"
                    CornerRadius="12"
                    Padding="24,16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="22" Foreground="#FF6CCB5F" VerticalAlignment="Center" />
                        <TextBlock x:Uid="CopiedToastLabel" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Uid="IdleHint"
                    Visibility="{x:Bind local:MainWindow.BoolToVisibility(ViewModel.IsIdleHintVisible), Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <!-- Overlaid (not a grid row) so opening it never changes the booth area's size. -->
                <InfoBar
                    x:Name="NoticeBar"
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                    Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                    VerticalAlignment="Top"
                    Margin="12,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
