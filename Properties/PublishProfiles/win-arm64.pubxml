<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained, unpackaged folder publish for win-arm64 (extract-and-run zip).
  Usage:  dotnet publish -c Release -p:PublishProfile=win-arm64
  Output: bin\publish\win-arm64\   (zip that folder as-is; ScreenshotBooth.exe runs with no runtime installs)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>bin\publish\win-arm64\</PublishDir>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
